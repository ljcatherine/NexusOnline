---
import Base from '../layouts/Base.astro';

// Each destination is Access-protected with instant auth, so following the link goes
// straight to the Nexus sign-in page (Keycloak, auth/keycloak in NexusBackend) and back. This page itself is public and holds no secrets.
const destinations = [
  { name: 'Nexus Online', detail: 'Terminals, files, host metrics and NexusAI in the browser.', href: '/app', tone: 'accent', icon: 'M4 6h16v10H4zM8 20h8M12 16v4' },
  { name: 'Minecraft panel', detail: 'Server status, console, players and backups.', href: 'https://minecraft.liamjc.dev/', tone: 'ok', icon: 'M4 7l8-4 8 4v10l-8 4-8-4zM4 7l8 4 8-4M12 11v10' },
];
---
<Base title="Sign in · Nexus" description="Owner-only sign-in for Nexus Online and the Minecraft panel.">
  <section class="wrap login">
    <div class="card">
      <div class="mark" aria-hidden="true">
        <img src="/favicon.svg" alt="" width="64" height="64">
        <span class="halo"></span>
      </div>
      <div class="eyebrow">Owner only</div>
      <h1>Sign in to <span class="grad">Nexus</span></h1>
      <p class="sub">Choose where to go. You'll confirm it's you with your passkey, then land straight in.</p>

      <ul class="dest" role="list">
        {destinations.map((d) => (
          <li>
            <a class={`tile ${d.tone}`} href={d.href}>
              <span class="ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={d.icon}/></svg>
              </span>
              <span class="txt"><b>{d.name}</b><small>{d.detail}</small></span>
              <span class="go">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M10.8 12.2 20 3M16 7l3 3M14 9l2 2"/></svg>
                Continue
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="fine">
        <p><span class="dot"></span>Protected by Cloudflare Access. Only the owner's account gets in; every other account is refused.</p>
        <p><a href="/cdn-cgi/access/logout">Sign out of Nexus</a> · <a href="/docs/security/">How sign-in works</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .login{display:grid;place-items:center;min-height:calc(100vh - 180px);padding:56px 0 72px}
  .card{position:relative;width:min(560px,100%);padding:40px 36px 28px;border-radius:28px;text-align:center;
    background:var(--glass),color-mix(in srgb,var(--surface) 72%,transparent);border:1px solid var(--border);
    box-shadow:var(--edge),0 40px 120px -40px color-mix(in srgb,var(--glow-a) 80%,transparent);
    backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
  .card::before{content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;pointer-events:none;
    background:linear-gradient(140deg,color-mix(in srgb,var(--accent) 55%,transparent),transparent 35%,transparent 65%,color-mix(in srgb,var(--purple) 50%,transparent));
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude}
  .mark{position:relative;width:76px;height:76px;margin:0 auto 22px;display:grid;place-items:center}
  .mark img{position:relative;z-index:1;border-radius:18px;box-shadow:0 12px 40px -8px color-mix(in srgb,var(--accent) 45%,transparent)}
  .halo{position:absolute;inset:-10px;border-radius:50%;border:1px solid color-mix(in srgb,var(--accent) 35%,transparent);animation:orbit 9s linear infinite}
  .halo::after{content:"";position:absolute;top:-4px;left:50%;width:8px;height:8px;border-radius:50%;background:var(--purple);box-shadow:0 0 12px var(--purple)}
  @keyframes orbit{to{transform:rotate(360deg)}}
  h1{font:800 clamp(30px,6vw,42px)/1.05 var(--display);letter-spacing:-.02em;margin:10px 0 10px}
  .sub{color:var(--muted);margin:0 auto 28px;max-width:40ch}
  .dest{list-style:none;margin:0;padding:0;display:grid;gap:12px;text-align:left}
  .tile{--tone:var(--accent);display:flex;align-items:center;gap:14px;padding:14px 14px 14px 16px;border-radius:18px;text-decoration:none;color:var(--text);
    background:color-mix(in srgb,var(--editor) 70%,transparent);border:1px solid var(--border);transition:transform .2s,border-color .2s,background .2s}
  .tile.ok{--tone:var(--ok)}
  .tile:hover{transform:translateY(-2px);border-color:var(--tone);background:color-mix(in srgb,var(--tone) 8%,var(--editor))}
  .ico{flex:none;width:44px;height:44px;border-radius:13px;display:grid;place-items:center;color:var(--tone);
    background:color-mix(in srgb,var(--tone) 12%,transparent);border:1px solid color-mix(in srgb,var(--tone) 30%,transparent)}
  .txt{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
  .txt b{font:600 16px var(--body)}
  .txt small{color:var(--muted);font-size:13px;line-height:1.4}
  .go{flex:none;display:inline-flex;align-items:center;gap:7px;padding:9px 13px;border-radius:11px;font:600 13px var(--body);
    color:var(--bg);background:linear-gradient(135deg,var(--tone),color-mix(in srgb,var(--tone) 55%,var(--purple)))}
  .fine{margin-top:26px;padding-top:18px;border-top:1px solid var(--border);font-size:13px;color:var(--dim)}
  .fine p{margin:6px 0}
  .fine a{color:var(--muted)}
  .fine a:hover{color:var(--accent)}
  .dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--ok);margin-right:8px;vertical-align:1px;box-shadow:0 0 0 4px color-mix(in srgb,var(--ok) 18%,transparent)}
  @media (max-width:520px){
    .card{padding:32px 18px 22px;border-radius:24px}
    .tile{flex-wrap:wrap}
    .go{width:100%;justify-content:center}
  }
  :global([data-motion="off"]) .halo{animation:none}
  @media (prefers-reduced-motion:reduce){.halo{animation:none}}
</style>
