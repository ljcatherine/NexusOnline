---
// Nexus Mail. Served only at mail.<domain>/ (owner only); the Worker 404s /mail on the public host.
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#070C18">
  <title>Inbox · Nexus Mail</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script is:inline src="/motion.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap">
</head>
<body class="mail-body">
  <div class="aura" aria-hidden="true"></div>
  <div class="mail">
    <aside class="rail">
      <a class="mbrand" href="/"><img src="/favicon.svg" alt="" width="26" height="26"><span>Nexus <em>Mail</em></span></a>
      <div id="boxes" class="boxes" role="navigation" aria-label="Mailboxes"></div>
      <div class="rail-foot">
        <span class="lock"><span aria-hidden="true">⛨</span> Private · owner only</span>
        <span id="me" class="me">Checking sign-in…</span>
        <a class="act" href="/cdn-cgi/access/logout">Sign out</a>
      </div>
    </aside>
    <section class="pane-list" aria-label="Messages">
      <div class="list-head">
        <label class="srch"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Search mail" aria-label="Search mail" autocomplete="off"><kbd>/</kbd></label>
        <button id="refresh" class="act icon" type="button" title="Check for new mail" aria-label="Check for new mail">↻</button>
      </div>
      <ul id="list" class="list"><li class="blank"><span>Loading mail…</span></li></ul>
    </section>
    <main id="reader" class="pane-read" tabindex="-1"></main>
  </div>
  <div id="status" class="toast" role="status" aria-live="polite"></div>
  <noscript><p class="noscript">Nexus Mail needs JavaScript.</p></noscript>
  <script>import '../../mail/main.ts';</script>
</body>
</html>

<style is:global>
  html:has(.mail-body){height:100%}
  body.mail-body{padding:0;height:100%;overflow:hidden}
  .mail{position:relative;z-index:1;height:100%;display:grid;grid-template-columns:232px minmax(300px,380px) 1fr;
    padding:env(safe-area-inset-top,0px) env(safe-area-inset-right,0px) 0 env(safe-area-inset-left,0px)}

  /* rail */
  .rail{display:grid;grid-template-rows:auto 1fr auto;gap:18px;padding:20px 12px max(16px,env(safe-area-inset-bottom,0px));border-right:1px solid var(--border);background:rgba(0,0,0,.18);min-height:0}
  .mbrand{display:flex;gap:10px;align-items:center;padding:0 8px;text-decoration:none;color:var(--text);font:700 19px var(--display);letter-spacing:-.01em}
  .mbrand em{font-style:normal;background:linear-gradient(135deg,var(--accent),var(--purple));-webkit-background-clip:text;background-clip:text;color:transparent}
  .boxes{display:grid;gap:3px;align-content:start;overflow:auto}
  .box{display:flex;gap:10px;align-items:center;width:100%;padding:9px 12px;border-radius:10px;border:0;background:none;color:var(--muted);font:500 14px var(--body);cursor:pointer;text-align:left;transition:background .2s,color .2s}
  .box:hover{background:rgba(255,255,255,.045);color:var(--text)}
  .box[aria-pressed="true"]{color:var(--text);background:color-mix(in srgb,var(--accent) 13%,transparent);box-shadow:var(--edge)}
  .bi{width:16px;text-align:center;color:var(--dim);font-size:13px}
  .box[aria-pressed="true"] .bi{color:var(--accent)}
  .bl{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .bc{font:600 11px var(--mono);color:var(--accent);font-variant-numeric:tabular-nums}
  .rail-h{margin:14px 12px 4px;font:500 10.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--dim)}
  .rail-foot{display:grid;gap:8px;padding:12px;border-radius:12px;background:var(--glass);border:1px solid var(--border);font-size:12.5px}
  .lock{font:500 11px var(--mono);color:var(--ok)}
  .me{color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .rail-foot .act{justify-self:start}

  /* buttons */
  .act{display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:9px;border:1px solid var(--border);background:var(--glass);box-shadow:var(--edge);color:var(--text);font:500 13px var(--body);text-decoration:none;cursor:pointer;transition:border-color .2s,background .2s;white-space:nowrap}
  .act:hover{border-color:var(--accent)}
  .act.icon{width:36px;height:36px;justify-content:center;padding:0;font-size:16px}
  .act.danger:hover{border-color:var(--err);color:var(--err)}
  .act.back{display:none}

  /* list */
  .pane-list{padding-block:0;display:grid;grid-template-rows:auto 1fr;min-height:0;border-right:1px solid var(--border);background:color-mix(in srgb,var(--bg) 55%,transparent)}
  .list-head{display:flex;gap:8px;padding:16px 14px 12px;border-bottom:1px solid var(--border)}
  .srch{flex:1;display:flex;align-items:center;gap:8px;padding:0 10px;border-radius:10px;background:var(--editor);border:1px solid var(--border);color:var(--dim)}
  .srch:focus-within{border-color:var(--accent)}
  .srch input{flex:1;min-width:0;border:0;background:none;color:var(--text);font:14px var(--body);padding:8px 0;outline:none}
  kbd{font:500 11px var(--mono);color:var(--dim);border:1px solid var(--border);border-radius:5px;padding:0 5px}
  .list{list-style:none;margin:0;padding:6px;overflow:auto;display:grid;align-content:start;gap:2px}
  .item{position:relative;width:100%;display:grid;grid-template-columns:36px 1fr;column-gap:12px;row-gap:1px;padding:11px 12px 11px 14px;border:1px solid transparent;border-radius:12px;background:none;color:var(--muted);font:inherit;text-align:left;cursor:pointer;transition:background .15s}
  .item:hover{background:rgba(255,255,255,.04)}
  .item[aria-current="true"]{background:color-mix(in srgb,var(--accent) 11%,var(--surface));border-color:color-mix(in srgb,var(--accent) 28%,transparent)}
  .item .av{grid-row:1/4;align-self:start;margin-top:2px}
  .it-top{display:flex;gap:8px;align-items:baseline;min-width:0}
  .from{flex:1;min-width:0;font-weight:500;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px}
  .it-top time{font:500 11.5px var(--mono);color:var(--dim);flex:none}
  .subj{font-size:13.5px;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .snip{font-size:12.5px;color:var(--dim);overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.45}
  .item.unread::before{content:"";position:absolute;left:4px;top:19px;width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent)}
  .item.unread .from,.item.unread .subj{font-weight:650}
  .item.unread .it-top time{color:var(--accent)}
  .clip{color:var(--purple)}
  .av{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;font:700 14px var(--display);color:#0b1020;
    background:linear-gradient(140deg,hsl(var(--h) 80% 78%),hsl(calc(var(--h) + 40) 70% 66%))}

  /* reader */
  .pane-read{min-width:0;min-height:0;overflow:auto;outline:none}
  .msg{display:grid;grid-template-rows:auto auto auto auto 1fr;min-height:100%;padding:0 clamp(16px,3vw,40px) 24px}
  .msg-bar{position:sticky;top:0;z-index:2;display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:16px 0 12px;background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:blur(12px)}
  .grow{flex:1}
  .seg{display:flex;padding:3px;border-radius:10px;background:var(--editor);border:1px solid var(--border)}
  .seg button{font:500 12.5px var(--body);padding:5px 11px;border:0;border-radius:7px;background:none;color:var(--muted);cursor:pointer}
  .seg button[aria-pressed="true"]{background:var(--elevated);color:var(--text);box-shadow:var(--edge)}
  .msg-subj{margin:10px 0 16px;font:700 clamp(22px,2.6vw,32px)/1.2 var(--display);letter-spacing:-.015em;overflow-wrap:anywhere;outline:none}
  .msg-meta{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding-bottom:16px;border-bottom:1px solid var(--border)}
  .msg-meta .av{width:42px;height:42px;font-size:16px}
  .who{min-width:0;overflow-wrap:anywhere}
  .who b{font-weight:600}
  .addr,.to{color:var(--muted);font-size:13px}
  .msg-meta time{font:500 12px var(--mono);color:var(--dim);align-self:start;text-align:right}
  .atts{list-style:none;margin:14px 0 0;padding:0;display:flex;gap:8px;flex-wrap:wrap}
  .atts li{display:flex;gap:6px;align-items:baseline;padding:6px 11px;border-radius:9px;background:var(--glass);border:1px solid var(--border);font-size:13px}
  .atts small{color:var(--dim);font:11px var(--mono)}
  .body{display:grid;grid-template-rows:auto 1fr;gap:10px;margin-top:18px;min-height:0}
  .note{margin:0;font-size:12.5px;color:var(--warn)}
  .body-html{width:100%;height:100%;min-height:60vh;border:0;border-radius:14px;background:#fff;box-shadow:0 20px 50px -20px rgba(0,0,0,.6)}
  .body-text{margin:0;padding:22px 24px;border-radius:14px;background:var(--editor);border:1px solid var(--border);font:14.5px/1.65 var(--body);white-space:pre-wrap;overflow-wrap:anywhere;align-self:start}

  .blank{display:grid;gap:6px;place-content:center;text-align:center;padding:48px 20px;color:var(--muted);font-size:14px;min-height:100%;list-style:none}
  .blank b{color:var(--text);font:600 18px var(--display)}
  .blank .big{font-size:40px;color:var(--accent);opacity:.6}
  .blank.err b{color:var(--err)}

  .toast{position:fixed;left:50%;bottom:max(20px,env(safe-area-inset-bottom,0px));z-index:20;transform:translate(-50%,20px);opacity:0;pointer-events:none;
    padding:10px 16px;border-radius:12px;background:var(--elevated);border:1px solid var(--border);box-shadow:var(--edge),0 12px 30px rgba(0,0,0,.4);font-size:13.5px;transition:opacity .25s,transform .25s}
  .toast.on{opacity:1;transform:translate(-50%,0)}
  .toast[data-tone="err"]{color:var(--err)}
  .noscript{position:fixed;inset:auto 16px 16px;z-index:9;color:var(--warn)}

  [data-motion="on"] .item,[data-motion="on"] .msg{animation:mailin .35s cubic-bezier(.2,.8,.2,1) both}
  @keyframes mailin{from{opacity:0;transform:translateY(8px)}}

  @media (max-width:1100px){ .mail{grid-template-columns:72px minmax(280px,340px) 1fr}
    .rail{padding-inline:10px}.mbrand span,.bl,.bc,.rail-h,.rail-foot .lock,.rail-foot .me{display:none}
    .rail{grid-template-columns:minmax(0,1fr)}
    .rail-foot{padding:0;background:none;border:0}.box{justify-content:center;padding:11px 0}.bi{font-size:16px}
    .rail-foot .act{justify-self:center;width:40px;height:40px;padding:0;justify-content:center;font-size:0}
    .rail-foot .act::before{content:"⎋";font-size:17px} }
  @media (max-width:860px){
    .mail{grid-template-columns:1fr;grid-template-rows:auto 1fr}
    .rail{grid-template-columns:auto 1fr auto;grid-template-rows:auto;align-items:center;padding:10px 16px;border-right:0;border-bottom:1px solid var(--border)}
    .boxes{display:flex;gap:4px;overflow-x:auto}.box{width:auto;padding:7px 12px}.bl,.bc{display:inline}.rail-h{display:none}
    .rail-foot{grid-template-columns:auto}
    .pane-list,.pane-read{grid-row:2;grid-column:1;border:0}
    .pane-read{display:none}
    .reading .pane-read{display:block}.reading .pane-list{display:none}
    .act.back{display:inline-flex}
    .msg{padding-inline:16px}
    .msg-meta{grid-template-columns:auto 1fr}.msg-meta time{grid-column:2;text-align:left}
    .body-html{min-height:70vh}
  }
</style>
