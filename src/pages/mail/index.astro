---
// Nexus Mail. Served only at mail.<domain>/ (owner only); the Worker 404s /mail on the public host.
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#070C18">
  <title>Inbox · Nexus Mail</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script is:inline src="/motion.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap">
</head>
<body class="mail-body">
  <div class="aura" aria-hidden="true"></div>
  <div class="mail">
    <header class="top">
      <button id="menu" class="ic only-sm" type="button" aria-label="Folders"></button>
      <a class="mbrand" href="#/inbox"><img src="/favicon.svg" alt="" width="26" height="26"><span>Nexus <em>Mail</em></span></a>
      <form id="search-form" class="search" role="search">
        <span id="search-icon" class="search-i"></span>
        <input id="search" type="search" placeholder="Search mail" aria-label="Search mail" autocomplete="off">
        <kbd>/</kbd>
      </form>
      <div class="me"><span id="me">Checking sign-in…</span><a class="pill-btn" href="/cdn-cgi/access/logout">Sign out</a></div>
    </header>
    <aside class="rail">
      <button id="compose" class="compose-btn" type="button">Compose</button>
      <div id="folders" class="folders" role="navigation" aria-label="Folders"></div>
      <p class="rail-foot"><span aria-hidden="true">⛨</span> Private. Stored only on your server.</p>
    </aside>
    <main id="main" class="pane" tabindex="-1"></main>
  </div>
  <div id="scrim" class="scrim" aria-hidden="true"></div>
  <button id="fab" class="fab only-sm" type="button" aria-label="Compose"></button>
  <datalist id="contacts"></datalist>
  <div id="toast" class="toast" role="status" aria-live="polite"></div>
  <noscript><p class="noscript">Nexus Mail needs JavaScript.</p></noscript>
  <script>import '../../mail/main.ts';</script>
</body>
</html>

<style is:global>
  html:has(.mail-body){height:100%}
  body.mail-body{padding:0;height:100%;overflow:hidden}
  .mail{position:relative;z-index:1;height:100%;display:grid;grid-template-columns:236px minmax(0,1fr);grid-template-rows:auto minmax(0,1fr);
    padding:env(safe-area-inset-top,0px) env(safe-area-inset-right,0px) 0 env(safe-area-inset-left,0px)}
  .i{width:20px;height:20px;flex:none;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .i.filled{fill:currentColor}
  .grow{flex:1}
  .only-sm{display:none!important}

  /* buttons */
  .ic{display:inline-grid;place-items:center;width:38px;height:38px;flex:none;border:0;border-radius:50%;background:none;color:var(--muted);cursor:pointer;transition:background .15s,color .15s}
  .ic:hover{background:rgba(255,255,255,.07);color:var(--text)}
  .ic:disabled{opacity:.35;cursor:default;background:none}
  .pill-btn{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;padding:8px 16px;border-radius:99px;border:1px solid var(--border);background:var(--glass);box-shadow:var(--edge);color:var(--text);font:500 13.5px var(--body);text-decoration:none;cursor:pointer;transition:border-color .2s}
  .pill-btn:hover{border-color:var(--accent)}
  .pill-btn .i{width:18px;height:18px}
  .pill-btn.danger{color:var(--err)}
  .pill-btn.danger:hover{border-color:var(--err)}
  .linkish{border:0;background:none;color:var(--muted);font:500 13px var(--body);cursor:pointer;padding:4px 6px;border-radius:6px}
  .linkish:hover{color:var(--text)}

  /* top bar */
  .top{grid-column:1/-1;display:flex;align-items:center;gap:16px;padding:10px 20px 10px 16px}
  .mbrand{display:flex;gap:10px;align-items:center;width:204px;flex:none;padding-left:6px;text-decoration:none;color:var(--text);font:700 20px var(--display);letter-spacing:-.01em}
  .mbrand em{font-style:normal;background:linear-gradient(135deg,var(--accent),var(--purple));-webkit-background-clip:text;background-clip:text;color:transparent}
  .search{flex:1;max-width:720px;display:flex;align-items:center;gap:10px;height:46px;padding:0 14px;border-radius:14px;background:color-mix(in srgb,var(--surface) 80%,transparent);border:1px solid var(--border);color:var(--dim);transition:background .2s,border-color .2s}
  .search:focus-within{background:var(--elevated);border-color:var(--accent);color:var(--text)}
  .search input{flex:1;min-width:0;border:0;background:none;color:var(--text);font:15px var(--body);outline:none}
  .search-i{display:grid}
  kbd{font:500 11px var(--mono);color:var(--dim);border:1px solid var(--border);border-radius:5px;padding:1px 6px}
  .me{margin-left:auto;display:flex;gap:12px;align-items:center;min-width:0;font-size:13px;color:var(--muted)}
  .me #me{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

  /* rail */
  .rail{display:grid;grid-template-rows:auto 1fr auto;gap:14px;padding:6px 12px max(16px,env(safe-area-inset-bottom,0px));min-height:0}
  .compose-btn{justify-self:start;display:inline-flex;align-items:center;gap:12px;padding:16px 24px 16px 20px;border-radius:18px;border:0;cursor:pointer;
    background:linear-gradient(135deg,var(--accent),var(--purple));color:#0a1022;font:600 15px var(--body);box-shadow:0 10px 30px -10px color-mix(in srgb,var(--accent) 70%,transparent);transition:transform .2s,box-shadow .2s}
  .compose-btn:hover{transform:translateY(-1px);box-shadow:0 14px 34px -10px color-mix(in srgb,var(--accent) 80%,transparent)}
  .folders{display:grid;gap:2px;align-content:start;overflow:auto}
  .folder{display:flex;align-items:center;gap:16px;height:36px;padding:0 14px 0 16px;border-radius:0 99px 99px 0;margin-left:-12px;color:var(--muted);text-decoration:none;font:500 14px var(--body)}
  .folder:hover{background:rgba(255,255,255,.05);color:var(--text)}
  .folder[aria-current]{background:color-mix(in srgb,var(--accent) 18%,transparent);color:var(--text);font-weight:600}
  .folder[aria-current] .i{color:var(--accent)}
  .folder.has-unread{color:var(--text);font-weight:600}
  .fl{flex:1}
  .fc{font:600 12px var(--mono);font-variant-numeric:tabular-nums}
  .rail-foot{margin:0;font-size:12px;color:var(--dim);padding:0 6px}

  /* pane */
  .pane{min-width:0;min-height:0;overflow:auto;margin:0 16px 16px 0;border-radius:18px;background:color-mix(in srgb,var(--surface) 62%,transparent);border:1px solid var(--border);box-shadow:var(--edge);outline:none;position:relative}
  .bar{position:sticky;top:0;z-index:3;display:flex;align-items:center;gap:4px;min-height:56px;padding:8px 12px;border-bottom:1px solid var(--border);background:color-mix(in srgb,var(--surface) 92%,var(--bg));border-radius:18px 18px 0 0}
  .bar-title{margin:0 8px;font:600 17px var(--display)}
  .hint{font-size:12.5px;color:var(--dim);margin-left:8px}
  .pager{display:flex;align-items:center;gap:2px;font-size:12.5px;color:var(--muted);font-variant-numeric:tabular-nums}
  .loading{padding:40px;text-align:center;color:var(--dim)}
  .empty{display:grid;gap:6px;justify-items:center;text-align:center;padding:80px 20px;color:var(--muted)}
  .empty .i{width:44px;height:44px;color:var(--accent);opacity:.55;margin-bottom:6px}
  .empty b{color:var(--text);font:600 19px var(--display)}
  .empty.err b{color:var(--err)}
  .empty .pill-btn{margin-top:10px}

  /* rows */
  .rows{list-style:none;margin:0;padding:0}
  .row{position:relative;display:grid;grid-template-columns:32px minmax(120px,200px) minmax(0,1fr) auto 72px;align-items:center;gap:10px;height:48px;padding:0 16px 0 10px;
    border-bottom:1px solid color-mix(in srgb,var(--border) 55%,transparent);cursor:pointer;color:var(--muted);font-size:14px;outline:none}
  .row:hover{box-shadow:inset 0 0 0 1px var(--border),0 2px 10px -4px rgba(0,0,0,.6);z-index:1;background:color-mix(in srgb,var(--elevated) 55%,transparent)}
  .row:focus-visible,.row.focus{box-shadow:inset 3px 0 0 var(--accent)}
  .row.unread{background:color-mix(in srgb,var(--accent) 6%,transparent);color:var(--text)}
  .row.unread .who,.row.unread .subj{font-weight:650;color:var(--text)}
  .who{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text)}
  .line{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .subj{color:var(--text)}
  .snip{color:var(--dim)}
  .clip .i{width:16px;height:16px;color:var(--dim)}
  .row time{justify-self:end;font:500 12px var(--mono);color:var(--dim);font-variant-numeric:tabular-nums}
  .row.unread time{color:var(--text)}
  .star,.star-gap{width:32px;height:32px}
  .star{display:grid;place-items:center;border:0;border-radius:50%;background:none;color:var(--dim);cursor:pointer}
  .star:hover{color:var(--text);background:rgba(255,255,255,.07)}
  .star.on{color:var(--warn)}
  .draft-l{color:var(--err);font-weight:600}
  .hover{display:none;position:absolute;right:8px;top:50%;transform:translateY(-50%);gap:2px;padding-left:24px;
    background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--elevated) 96%,transparent) 24px)}
  .row:hover .hover,.row:focus-within .hover{display:flex}
  .row:hover time,.row:focus-within time{visibility:hidden}
  .hover .ic{width:34px;height:34px}

  /* conversation */
  .conv{padding:8px clamp(16px,3vw,40px) 40px;display:grid;gap:10px}
  .conv-subj{margin:14px 0 10px 52px;font:600 clamp(20px,2.2vw,26px)/1.3 var(--display);letter-spacing:-.01em;outline:none;overflow-wrap:anywhere}
  .label{display:inline-block;vertical-align:middle;margin-left:10px;padding:2px 8px;border-radius:6px;background:rgba(255,255,255,.08);color:var(--muted);font:500 11.5px var(--body);letter-spacing:.02em}
  .msg{border:1px solid transparent;border-radius:14px;transition:background .2s}
  .msg:not(.open){background:color-mix(in srgb,var(--elevated) 35%,transparent);border-color:color-mix(in srgb,var(--border) 60%,transparent)}
  .msg-h{display:grid;grid-template-columns:40px minmax(0,1fr) auto auto;gap:12px;align-items:center;padding:12px 12px 12px 6px;cursor:pointer}
  .msg.open .msg-h{cursor:default;align-items:start}
  .msg-who{min-width:0}
  .msg-who b{font-weight:600;color:var(--text)}
  .addr,.msg-to{color:var(--muted);font-size:12.5px}
  .msg-to{margin-top:2px}
  .msg-snip{color:var(--dim);font-size:13.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .msg-h time{font:500 12px var(--mono);color:var(--dim);padding-top:2px}
  .msg-acts{display:flex;margin-top:-6px}
  .msg-body{padding:0 12px 6px 58px}
  .msg .note{margin:-4px 12px 8px 58px;font-size:12.5px;color:var(--warn)}
  .text{white-space:pre-wrap;overflow-wrap:anywhere;font:14.5px/1.65 var(--body);color:var(--text)}
  .text a{color:var(--accent)}
  .html{display:block;width:100%;height:min(70vh,720px);min-height:160px;border:0;border-radius:12px;background:#fff;resize:vertical;overflow:auto}
  .unverified{margin:0 12px 10px 58px;padding:10px 14px;border-radius:10px;font-size:13px;color:var(--warn);background:color-mix(in srgb,var(--warn) 12%,transparent);border:1px solid color-mix(in srgb,var(--warn) 35%,transparent)}
  .unverified b{color:var(--warn)}
  .av{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;font:700 15px var(--display);color:#0b1020;
    background:linear-gradient(140deg,hsl(var(--h) 80% 78%),hsl(calc(var(--h) + 40) 70% 66%))}
  .atts{display:flex;flex-wrap:wrap;gap:10px;padding:8px 12px 14px 58px}
  .att{display:grid;grid-template-columns:auto minmax(0,1fr) auto;grid-template-rows:auto auto;column-gap:10px;align-items:center;width:220px;padding:10px 12px;border-radius:12px;border:1px solid var(--border);background:var(--glass);color:var(--text);text-decoration:none;transition:border-color .2s}
  .att:hover{border-color:var(--accent)}
  .att-i{grid-row:1/3;display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:color-mix(in srgb,var(--purple) 18%,transparent);color:var(--purple)}
  .att-n{font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .att small{grid-column:2;color:var(--dim);font:11px var(--mono)}
  .att > .i:last-child{grid-row:1/3;grid-column:3;color:var(--dim);width:18px;height:18px}
  .conv-reply{display:flex;flex-wrap:wrap;gap:10px;padding:10px 0 0 58px}

  /* composer */
  .composer{position:fixed;right:24px;bottom:0;z-index:40;width:min(560px,calc(100vw - 32px));height:min(600px,calc(100vh - 80px));display:grid;grid-template-rows:auto minmax(0,1fr) auto;
    border-radius:16px 16px 0 0;background:var(--elevated);border:1px solid var(--border);border-bottom:0;box-shadow:0 24px 60px -12px rgba(0,0,0,.75),var(--edge);overflow:hidden;animation:cmpin .25s cubic-bezier(.2,.8,.2,1)}
  @keyframes cmpin{from{transform:translateY(24px);opacity:0}}
  .composer.min{height:auto;grid-template-rows:auto;width:300px}
  .composer.min .cmp-main,.composer.min .cmp-foot{display:none}
  .composer.max{right:50%;bottom:50%;transform:translate(50%,50%);width:min(1000px,calc(100vw - 48px));height:min(760px,calc(100vh - 48px));border-radius:16px;border-bottom:1px solid var(--border);animation:none}
  .composer.sending .cmp-main{opacity:.6;pointer-events:none}
  .cmp-head{display:flex;align-items:center;gap:2px;padding:4px 6px 4px 16px;background:color-mix(in srgb,var(--surface) 80%,var(--bg));cursor:pointer;font-size:14px}
  .cmp-head b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .cmp-head .ic{width:32px;height:32px}
  .cmp-head .i{width:17px;height:17px}
  .cmp-main{display:flex;flex-direction:column;min-height:0;padding:0 16px;overflow:auto}
  .cmp-row{display:flex;align-items:center;gap:6px;border-bottom:1px solid var(--border)}
  .cmp-row[hidden]{display:none}
  .rcpt{flex:1;display:flex;flex-wrap:wrap;align-items:center;gap:4px;min-height:42px;padding:4px 0;cursor:text;min-width:0}
  .rcpt + .rcpt{border-left:1px solid var(--border);padding-left:10px}
  .rcpt-l{color:var(--dim);font-size:13.5px;margin-right:4px}
  .rcpt input{flex:1;min-width:120px;border:0;background:none;color:var(--text);font:14px var(--body);outline:none;padding:4px 0}
  .chips{display:contents}
  .chip{display:inline-flex;align-items:center;gap:4px;max-width:100%;padding:3px 4px 3px 10px;border-radius:99px;background:color-mix(in srgb,var(--accent) 16%,var(--surface));font:500 13px var(--body);color:var(--text)}
  .chip.bad{background:color-mix(in srgb,var(--err) 20%,var(--surface));color:var(--err)}
  .chip button,.file button{border:0;background:none;color:inherit;opacity:.7;cursor:pointer;font-size:15px;line-height:1;padding:0 4px;border-radius:99px}
  .chip button:hover,.file button:hover{opacity:1}
  .cmp-from{flex:1;border:0;background:none;color:var(--text);font:14px var(--body);padding:8px 0;outline:none}
  .cmp-from option{background:var(--elevated)}
  .cmp-subject{border:0;border-bottom:1px solid var(--border);background:none;color:var(--text);font:500 14.5px var(--body);padding:12px 0;outline:none}
  .cmp-body{flex:1;min-height:180px;border:0;background:none;color:var(--text);font:14.5px/1.6 var(--body);padding:14px 0;resize:none;outline:none}
  .cmp-files{display:flex;flex-wrap:wrap;gap:6px;padding-bottom:8px}
  .cmp-files:empty{display:none}
  .file{display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:5px 6px 5px 10px;border-radius:9px;background:var(--surface);border:1px solid var(--border);font-size:12.5px}
  .file .i{width:15px;height:15px;color:var(--purple)}
  .file .fn{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:220px}
  .file small{color:var(--dim);font:11px var(--mono)}
  .cmp-error{margin:0 0 10px;padding:9px 12px;border-radius:10px;font-size:13px;color:var(--err);background:color-mix(in srgb,var(--err) 12%,transparent)}
  .cmp-warn{margin:10px 0 0;padding:9px 12px;border-radius:10px;font-size:12.5px;color:var(--warn);background:color-mix(in srgb,var(--warn) 10%,transparent)}
  .cmp-foot{display:flex;align-items:center;gap:6px;padding:10px 12px 12px 16px}
  .cmp-status{font-size:12px;color:var(--dim);margin-left:6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .btn-send{padding:10px 26px;border-radius:99px;border:0;cursor:pointer;background:linear-gradient(135deg,var(--accent),var(--purple));color:#0a1022;font:600 14px var(--body)}
  .btn-send:hover{filter:brightness(1.07)}

  /* toast, drawer, fab */
  .toast{position:fixed;left:24px;bottom:max(24px,env(safe-area-inset-bottom,0px));z-index:50;display:flex;align-items:center;gap:18px;padding:12px 14px 12px 18px;border-radius:12px;
    background:#E9EDF7;color:#0a1022;font-size:14px;box-shadow:0 14px 40px -8px rgba(0,0,0,.6);transform:translateY(20px);opacity:0;pointer-events:none;transition:opacity .2s,transform .2s}
  .toast.on{opacity:1;transform:none;pointer-events:auto}
  .toast[data-tone="err"]{background:var(--err)}
  .toast button{border:0;background:none;color:#2f4fa8;font:600 14px var(--body);cursor:pointer;padding:4px 6px;border-radius:6px}
  .toast button:hover{background:rgba(0,0,0,.06)}
  .scrim{display:none}
  .fab{position:fixed;right:18px;bottom:max(18px,env(safe-area-inset-bottom,0px));z-index:30;width:58px;height:58px;border-radius:18px;border:0;place-items:center;
    background:linear-gradient(135deg,var(--accent),var(--purple));color:#0a1022;box-shadow:0 12px 30px -8px color-mix(in srgb,var(--accent) 70%,transparent);cursor:pointer}
  .fab .i{width:24px;height:24px}
  .noscript{position:fixed;inset:auto 16px 16px;z-index:9;color:var(--warn)}
  [data-motion="on"] .rows li,[data-motion="on"] .msg{animation:rowin .3s cubic-bezier(.2,.8,.2,1) both}
  @keyframes rowin{from{opacity:0;transform:translateY(6px)}}

  @media (max-width:1100px){ .row{grid-template-columns:32px minmax(100px,160px) minmax(0,1fr) auto 64px} .me #me{display:none} }
  @media (max-width:860px){
    .only-sm{display:grid!important}
    .mail{grid-template-columns:1fr}
    .top{gap:8px;padding:8px 12px}
    .mbrand{width:auto}.mbrand span,.search kbd,.compose-btn{display:none}
    .me .pill-btn{padding:7px 12px}
    .rail{position:fixed;inset:0 auto 0 0;z-index:45;width:min(280px,82vw);padding-top:max(16px,env(safe-area-inset-top,0px));background:var(--surface);border-right:1px solid var(--border);
      transform:translateX(-102%);transition:transform .25s cubic-bezier(.2,.8,.2,1);grid-template-rows:1fr auto}
    .drawer .rail{transform:none}
    .drawer .scrim{display:block;position:fixed;inset:0;z-index:44;background:rgba(0,0,0,.5)}
    .pane{margin:0;border-radius:0;border-width:1px 0 0}
    .bar{border-radius:0}
    .row{grid-template-columns:28px minmax(0,1fr) auto;grid-template-rows:auto auto;height:auto;padding:10px 12px 10px 6px;row-gap:2px}
    .row .star,.row .star-gap{grid-row:1/3}
    .row .who{grid-column:2}.row time{grid-column:3;grid-row:1}
    .row .line{grid-column:2/4;grid-row:2;white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
    .row .clip{display:none}
    .row:hover .hover{display:none}.row:hover time{visibility:visible}
    .conv{padding:4px 12px 90px}
    .conv-subj{margin-left:4px}
    .msg-h{grid-template-columns:36px minmax(0,1fr) auto;padding:10px 4px}
    .msg-h .msg-acts{grid-column:2/4;justify-content:flex-end;margin:0}
    .msg-body,.atts,.conv-reply{padding-left:0}
    .msg .note{margin-left:4px}
    .att{width:100%}
    .composer,.composer.max{inset:0;transform:none;width:100%;height:100%;border-radius:0;padding-top:env(safe-area-inset-top,0px)}
    .composer.min{inset:auto 0 0 0;height:auto;width:100%}
    .hide-sm{display:none}
    .toast{left:12px;right:12px;bottom:90px}
  }
</style>
