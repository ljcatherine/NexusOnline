---
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#070C18">
  <title>Nexus Online</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script is:inline src="/motion.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap">
</head>
<body class="app-body">
  <div class="aura" aria-hidden="true"></div>
  <a class="skip" href="#view">Skip to content</a>
  <div class="shell">
    <aside class="rail">
      <a class="brand" href="/"><img src="/favicon.svg" alt="" width="30" height="30"><span>Nexus <em>Online</em></span></a>
      <nav class="app-nav" aria-label="App">
        <span class="ind" aria-hidden="true"></span>
        <a href="#overview"><span class="ti" aria-hidden="true">▦</span><span class="tl">Overview</span></a>
        <a href="#devices"><span class="ti" aria-hidden="true">▤</span><span class="tl">Devices</span></a>
        <a href="#chat"><span class="ti" aria-hidden="true">✦</span><span class="tl">AI</span></a>
        <a href="#settings"><span class="ti" aria-hidden="true">⚙</span><span class="tl">Settings</span></a>
      </nav>
      <div class="me"><span class="led ok" aria-hidden="true"></span><span id="who" class="muted">Checking sign-in…</span><button id="signout" class="btn small" type="button">Sign out</button></div>
    </aside>
    <main id="view" class="view" tabindex="-1"></main>
  </div>
  <noscript><p class="noscript">Nexus Online needs JavaScript.</p></noscript>
  <script>import '../../app/main.ts';</script>
</body>
</html>

<style is:global>
  /* Undo the landing page's section/nav rules (global.css) inside the app; the classes below set their own. */
  .app-body :where(section){padding-block:0}
  .app-body :where(nav){position:static;margin:0;padding:0;background:none;border:0;backdrop-filter:none;-webkit-backdrop-filter:none;z-index:auto}

  /* ---------- shell: floating glass rail (desktop) / tab bar (phone), like the iPhone app ---------- */
  body.app-body{padding:0;height:100%;overflow:hidden}
  html:has(.app-body){height:100%}
  .skip{position:absolute;left:-999px;top:8px;z-index:100;background:var(--accent);color:var(--bg);padding:8px 12px;border-radius:8px}
  .skip:focus{left:12px}
  .shell{position:relative;z-index:1;height:100%;display:grid;grid-template-columns:232px 1fr;gap:0;
    padding:max(14px,env(safe-area-inset-top,0px)) 0 0 max(14px,env(safe-area-inset-left,0px))}
  .rail,.card{background:linear-gradient(180deg,rgba(255,255,255,.085),rgba(255,255,255,.025)),color-mix(in srgb,var(--surface) 82%,transparent);
    backdrop-filter:blur(22px) saturate(150%);-webkit-backdrop-filter:blur(22px) saturate(150%);
    border:1px solid rgba(255,255,255,.09);box-shadow:inset 0 1px 0 rgba(255,255,255,.16),0 18px 40px -18px rgba(3,8,24,.75)}
  .rail{display:grid;grid-template-rows:auto 1fr auto;gap:18px;padding:18px 12px;border-radius:26px;margin-bottom:14px;min-height:0}
  .brand{display:flex;gap:10px;align-items:center;padding:2px 8px;color:var(--text);text-decoration:none;font:800 19px var(--display)}
  .brand em{font-style:normal;color:var(--accent)}
  .app-nav{position:relative;display:grid;gap:4px;align-content:start;--i:0}
  .app-nav .ind{position:absolute;left:0;right:0;top:0;height:46px;border-radius:16px;pointer-events:none;
    background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 22%,transparent),color-mix(in srgb,var(--purple) 16%,transparent));
    box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 0 0 1px color-mix(in srgb,var(--accent) 28%,transparent);
    transform:translateY(calc(var(--i) * 50px));transition:transform .45s cubic-bezier(.34,1.4,.5,1)}
  .app-nav a{position:relative;display:flex;gap:12px;align-items:center;height:46px;padding:0 10px;border-radius:16px;color:var(--muted);text-decoration:none;font:500 14.5px var(--body);transition:color .25s}
  .app-nav a:hover{color:var(--text)}
  .app-nav a[aria-current]{color:var(--text)}
  .ti{width:30px;height:30px;display:grid;place-items:center;border-radius:10px;font-size:15px;color:var(--dim);background:rgba(255,255,255,.04);transition:color .25s,background .25s,transform .35s cubic-bezier(.34,1.6,.5,1)}
  .app-nav a[aria-current] .ti{color:var(--bg);background:linear-gradient(135deg,var(--accent),var(--purple));transform:scale(1.06)}
  .app-nav a:active .ti{transform:scale(.9)}
  .me{display:grid;grid-template-columns:auto 1fr;gap:6px 8px;align-items:center;padding:12px 8px 0;border-top:1px solid rgba(255,255,255,.07);font-size:12.5px;min-width:0}
  .me #who{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .me .btn{grid-column:1/-1;justify-content:center}
  .view{overflow:auto;padding:14px max(20px,env(safe-area-inset-right,0px)) 48px 24px;display:grid;gap:18px;align-content:start;min-width:0;view-transition-name:view}
  .view:focus{outline:none}

  /* ---------- type, controls ---------- */
  .muted{color:var(--muted)} .small{font-size:12.5px} .mono{font-family:var(--mono)} .pad{padding:12px}
  .view-head{display:flex;gap:14px 20px;align-items:end;justify-content:space-between;flex-wrap:wrap;padding-top:8px}
  .view-head h1{font:800 clamp(30px,3.6vw,42px)/1.05 var(--display);letter-spacing:-.025em;margin:0}
  .view-head p{margin:6px 0 0;color:var(--muted);max-width:68ch}
  .card{position:relative;border-radius:26px}
  .btn.small{padding:7px 13px;font-size:13px;border-radius:12px}
  .btn{transition:transform .25s cubic-bezier(.34,1.6,.5,1),border-color .2s,box-shadow .2s,background .2s}
  .btn:active{transform:scale(.95)!important}
  .btn.primary:hover{box-shadow:0 8px 24px -8px color-mix(in srgb,var(--accent) 70%,transparent)}
  .pill.err{color:var(--err);background:color-mix(in srgb,var(--err) 12%,transparent)}
  .error{padding:12px 14px;border-radius:14px;color:var(--err);background:color-mix(in srgb,var(--err) 10%,transparent);border:1px solid color-mix(in srgb,var(--err) 30%,transparent);font-size:14px;overflow-wrap:anywhere;animation:shake .4s ease}
  .empty{display:grid;gap:6px;place-content:center;text-align:center;padding:40px 16px;color:var(--muted)}
  .empty h2{font:700 21px var(--display);color:var(--text);margin:0}
  .empty p{margin:0}
  .bar{display:block;height:6px;border-radius:3px;background:rgba(255,255,255,.07);overflow:hidden}
  .bar.wide{height:8px}
  .bar i{display:block;height:100%;width:0;border-radius:inherit;transition:width .9s cubic-bezier(.2,.8,.2,1)}
  .stack{display:grid;gap:16px} .stack.tight{gap:8px}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .row.end{justify-content:flex-end}
  select,input[type=search],input[type=text],textarea{font:inherit;color:var(--text);background:rgba(4,8,20,.55);border:1px solid var(--border);border-radius:12px;padding:8px 12px;min-width:0;transition:border-color .2s,box-shadow .2s}
  select:focus,input:focus,textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 25%,transparent)}
  .field{display:grid;gap:4px;font-size:12.5px;color:var(--muted)}
  .check{display:flex;gap:10px;align-items:flex-start;cursor:pointer;font-size:14px}
  .check.inline{align-items:center;font-size:13px;color:var(--muted)}
  .check input{margin-top:4px;accent-color:var(--accent)} .check.inline input{margin:0}
  .check span{display:grid} .check small{color:var(--muted)}
  button:disabled{opacity:.5;cursor:not-allowed;transform:none!important}
  .tile{width:38px;height:38px;flex:none;display:grid;place-items:center;border-radius:13px;font-size:17px;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 6px 16px -8px rgba(0,0,0,.8)}
  .tile.accent,.tile.blue{background:linear-gradient(145deg,#6E95E8,#3D5FB4);color:#E9F0FF}
  .tile.purple{background:linear-gradient(145deg,#A784E8,#6A47B8);color:#F3ECFF}
  .tile.green{background:linear-gradient(145deg,#4CC9A6,#21876C);color:#E9FFF8}
  .tile.red{background:linear-gradient(145deg,#E3667A,#A63A4C);color:#FFEEF1}
  .led{width:8px;height:8px;border-radius:50%;display:inline-block;flex:none}
  .led.ok{background:var(--ok);box-shadow:0 0 10px var(--ok);animation:pulse 2s infinite}
  .led.off{background:var(--dim)}
  .seg{display:inline-flex;padding:3px;border-radius:13px;background:rgba(4,8,20,.55);border:1px solid var(--border)}
  .seg-b{font:500 13px var(--body);padding:6px 13px;border:0;border-radius:10px;background:none;color:var(--muted);cursor:pointer;transition:background .3s,color .3s,box-shadow .3s}
  .seg-b[aria-pressed="true"]{background:linear-gradient(180deg,rgba(255,255,255,.14),rgba(255,255,255,.06));color:var(--text);box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 2px 8px rgba(0,0,0,.3)}
  .subnav{display:inline-flex;gap:2px;padding:4px;border-radius:16px;background:rgba(4,8,20,.5);border:1px solid var(--border)}
  .subnav a{padding:7px 15px;border-radius:12px;color:var(--muted);text-decoration:none;font:500 13.5px var(--body);transition:color .25s,background .25s}
  .subnav a:hover{color:var(--text)}
  .subnav a[aria-current]{color:var(--bg);background:linear-gradient(135deg,var(--accent),var(--purple));box-shadow:0 4px 14px -4px color-mix(in srgb,var(--accent) 60%,transparent)}
  .icon-b{width:30px;height:30px;display:inline-grid;place-items:center;border-radius:10px;border:1px solid transparent;background:none;color:var(--muted);cursor:pointer;font-size:14px;transition:background .2s,color .2s,transform .2s}
  .icon-b:hover{background:rgba(255,255,255,.07);color:var(--text)}
  .icon-b:active{transform:scale(.88)}
  .icon-b.danger:hover{color:var(--err);background:color-mix(in srgb,var(--err) 12%,transparent)}

  /* ---------- overview ---------- */
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .stat{padding:18px 20px;display:grid;gap:6px;align-content:start}
  .stat.wide{grid-column:span 2;grid-template-columns:1fr auto;align-items:center}
  .stat.wide .stat-l,.stat.wide .stat-s,.stat.wide .stat-x{grid-column:1/-1}
  .stat-l{font:500 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--dim)}
  .stat-v{font:700 26px/1.15 var(--display);letter-spacing:-.01em;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}
  .stat-s{color:var(--muted);font-size:13px;font-variant-numeric:tabular-nums}
  .stat-x{margin-top:6px}
  .spark{width:100%;height:70px;display:block}
  .host-stats{display:grid;gap:9px}
  .meter-row{display:grid;grid-template-columns:62px 1fr;gap:2px 10px;align-items:center;font-size:13px}
  .meter-row small{grid-column:2;color:var(--muted);font:12px var(--mono)}

  /* ---------- devices ---------- */
  .device-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(320px,100%),1fr));gap:16px}
  .device{padding:18px 20px;display:grid;gap:14px;align-content:start}
  .device-h{display:flex;gap:12px;align-items:center}
  .device-h > div{display:grid;flex:1;min-width:0}
  .device-h h2{font:700 19px var(--display);margin:0}
  .device-actions{display:flex;gap:8px;flex-wrap:wrap}
  .device-more summary{cursor:pointer;color:var(--muted);font-size:13px}
  .device-more[open]{display:grid;gap:10px}
  .device-more code,.pin-row code{font:12px var(--mono);overflow-wrap:anywhere;color:var(--muted)}
  .pin-row{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:10px 12px;border-radius:14px;background:rgba(4,8,20,.4)}
  .pin-row > span{display:grid;gap:2px;min-width:0}

  /* ---------- terminal ---------- */
  .term-card{display:grid;grid-template-rows:auto auto 1fr auto;gap:10px;padding:14px;height:calc(100vh - 190px);min-height:440px}
  .term-top{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .term-tabs{display:flex;gap:6px;overflow-x:auto;min-height:0}
  .term-tab{display:flex;align-items:center;border-radius:12px;background:rgba(4,8,20,.45);border:1px solid var(--border);animation:pop .35s cubic-bezier(.34,1.5,.5,1) both}
  .term-tab.on{border-color:color-mix(in srgb,var(--accent) 50%,transparent);background:color-mix(in srgb,var(--accent) 12%,rgba(4,8,20,.45))}
  .term-tab-b{display:flex;gap:8px;align-items:center;background:none;border:0;color:var(--text);font:500 12.5px var(--mono);padding:7px 4px 7px 11px;cursor:pointer;white-space:nowrap}
  .term-tab .x{background:none;border:0;color:var(--muted);cursor:pointer;font-size:16px;padding:0 9px 0 4px}
  .term-stage{min-height:0;border-radius:18px;overflow:hidden;background:#0A1020;border:1px solid var(--border)}
  .term-host{height:100%;padding:8px 4px 4px 10px}
  .term-host .xterm{height:100%}
  .term-keys{display:none;gap:6px;overflow-x:auto}
  .key{flex:none;padding:7px 11px;border-radius:10px;border:1px solid var(--border);background:rgba(4,8,20,.5);color:var(--text);font:500 12.5px var(--mono);cursor:pointer}
  .key:active{transform:scale(.92);background:color-mix(in srgb,var(--accent) 20%,transparent)}

  /* ---------- files ---------- */
  .files{display:grid;grid-template-columns:minmax(320px,440px) 1fr;gap:16px;height:calc(100vh - 190px);min-height:480px}
  .browser{padding:12px;display:grid;grid-template-rows:auto auto auto 1fr auto;gap:10px;min-height:0;transition:box-shadow .2s,border-color .2s}
  .browser.drop{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 30%,transparent)}
  .browser .row input[type=search]{flex:1}
  .file-tools{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
  .crumbs{display:flex;flex-wrap:wrap;gap:1px;align-items:center;font:500 12.5px var(--mono);color:var(--dim)}
  .crumbs button{background:none;border:0;color:var(--accent);font:inherit;cursor:pointer;padding:2px 4px;border-radius:6px}
  .crumbs button:hover{background:rgba(255,255,255,.06)}
  .file-list{overflow:auto;display:grid;align-content:start;gap:1px;min-height:0}
  .file-row{display:grid;grid-template-columns:1fr auto auto auto;gap:10px;align-items:center;padding:0 4px 0 0;border-radius:12px;animation:rowin .3s ease both}
  .file-row:hover{background:rgba(255,255,255,.05)}
  .file-row small{color:var(--dim);font-size:11.5px;white-space:nowrap}
  .file-name{display:flex;gap:8px;align-items:center;min-width:0;text-align:left;padding:7px 8px;border:0;background:none;color:var(--text);font:13.5px var(--body);cursor:pointer;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .file-row.dir .file-name{color:var(--accent)}
  .file-name .ico{width:12px;color:var(--dim);flex:none}
  .row-actions{display:flex;opacity:.35;transition:opacity .2s}
  .file-row:hover .row-actions,.file-row:focus-within .row-actions{opacity:1}
  .transfers{display:grid;gap:6px}
  .transfer{display:grid;grid-template-columns:1fr auto;gap:4px 8px;align-items:center;padding:8px 10px;border-radius:12px;background:rgba(4,8,20,.5);font-size:12.5px;animation:pop .3s ease both}
  .transfer b{font:500 12px var(--mono);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .transfer .bar,.transfer small{grid-column:1}
  .transfer small{color:var(--muted)}
  .transfer .icon-b{grid-row:1/4;grid-column:2}
  .transfer .bar i{background:linear-gradient(90deg,var(--accent),var(--purple))}
  .transfer.done .bar i{background:var(--ok)} .transfer.failed small{color:var(--err)}
  .viewer{display:grid;grid-template-rows:auto 1fr;min-height:0;overflow:hidden}
  .viewer-h{display:flex;gap:12px;justify-content:space-between;align-items:center;flex-wrap:wrap;padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.07)}
  .viewer-h > div:first-child{display:grid;min-width:0}
  .viewer-h b{font:600 13.5px var(--mono);overflow-wrap:anywhere}
  .viewer-tools{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  .editor{border:0;border-radius:0 0 26px 26px;background:#0A1020;font:13px/1.6 var(--mono);padding:14px 18px;resize:none;tab-size:4;white-space:pre;overflow:auto;min-height:0;height:100%}
  .editor:focus{box-shadow:none}

  /* ---------- AI chat ---------- */
  .chat{display:grid;grid-template-columns:270px 1fr;gap:16px;height:calc(100vh - 190px);min-height:480px}
  .chat-side{padding:14px;display:grid;gap:10px;align-content:start;overflow:auto}
  .chat-side select{width:100%}
  .side-h{font:500 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin:8px 0 0}
  .chat-list,.chat-remote{display:grid;gap:3px}
  .chat-item{display:grid;gap:2px;text-align:left;padding:8px 10px;border-radius:12px;border:1px solid transparent;background:none;color:var(--text);cursor:pointer;font:inherit;transition:background .2s,border-color .2s,transform .2s}
  .chat-item b{font-weight:500;font-size:13.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .chat-item small{color:var(--dim);font-size:12px}
  .chat-item:hover{background:rgba(255,255,255,.05);transform:translateX(2px)}
  .chat-item.on{background:color-mix(in srgb,var(--accent) 13%,transparent);border-color:color-mix(in srgb,var(--accent) 30%,transparent)}
  .chat-main{display:grid;grid-template-rows:auto 1fr auto;min-height:0;overflow:hidden}
  .chat-head{display:flex;gap:10px;align-items:center;justify-content:space-between;padding:12px 18px;border-bottom:1px solid rgba(255,255,255,.07);min-height:54px}
  .chat-head b{font:600 15px var(--display);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .chat-actions{display:flex;gap:2px}
  .thread{overflow:auto;padding:20px;display:grid;gap:14px;align-content:start}
  .msg{max-width:min(78ch,100%);padding:12px 16px;border-radius:22px;font-size:14.5px;display:grid;gap:8px;animation:bubble .45s cubic-bezier(.34,1.3,.5,1) both}
  .msg p{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}
  .msg.user{justify-self:end;background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 30%,var(--elevated)),color-mix(in srgb,var(--purple) 24%,var(--elevated)));border-bottom-right-radius:7px;transform-origin:bottom right}
  .msg.assistant{justify-self:start;background:rgba(32,43,66,.7);border:1px solid rgba(255,255,255,.07);border-bottom-left-radius:7px;transform-origin:bottom left}
  .msg-img{max-width:240px;max-height:200px;border-radius:14px;object-fit:cover}
  .msg-files{display:flex;gap:6px;flex-wrap:wrap}
  .msg-tools{display:flex;gap:6px;opacity:0;transition:opacity .2s}
  .msg:hover .msg-tools,.msg:focus-within .msg-tools{opacity:1}
  .copy{font:500 11.5px var(--mono);color:var(--muted);background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:8px;padding:3px 9px;cursor:pointer}
  .copy:hover{color:var(--text)}
  .rich{display:grid;gap:8px;overflow-wrap:anywhere}
  .rich h3,.rich h4{font:700 16px var(--display);margin:4px 0 0}
  .rich ul,.rich ol{margin:0;padding-left:22px;display:grid;gap:3px}
  .rich blockquote{margin:0;padding-left:12px;border-left:3px solid var(--purple);color:var(--muted)}
  .rich code{font:12.5px var(--mono);background:rgba(4,8,20,.6);padding:1px 6px;border-radius:6px}
  .codeblock{border-radius:14px;overflow:hidden;border:1px solid var(--border);background:#0A1020}
  .code-h{display:flex;justify-content:space-between;align-items:center;padding:5px 8px 5px 12px;font:500 11px var(--mono);color:var(--dim);background:rgba(255,255,255,.03)}
  .codeblock pre{margin:0;padding:12px;overflow:auto;font:12.5px/1.55 var(--mono)}
  .codeblock pre code{background:none;padding:0}
  .sources{display:flex;gap:6px;flex-wrap:wrap;align-items:center;font:500 11.5px var(--mono)}
  .sources > span{color:var(--dim)}
  .sources a{color:var(--accent);text-decoration:none;padding:3px 8px;border-radius:8px;background:color-mix(in srgb,var(--accent) 10%,transparent)}
  .tool{font:500 12px var(--mono);color:var(--muted);display:flex;gap:8px;flex-wrap:wrap;padding:7px 12px;border-radius:12px;border:1px dashed var(--border);justify-self:start;animation:pop .3s ease both}
  .typing{display:inline-flex;gap:5px;padding:4px 2px}
  .typing i{width:7px;height:7px;border-radius:50%;background:var(--purple);animation:typing 1.2s infinite ease-in-out}
  .typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}
  .composer{display:grid;gap:8px;padding:12px 14px 14px;border-top:1px solid rgba(255,255,255,.07);transition:background .2s}
