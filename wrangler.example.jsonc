// Copy to wrangler.jsonc (git-ignored) and fill in the four REPLACE values.
// See DEPLOY.md. The Worker fails closed: until these are set, /app and /api answer 401.
{
  "name": "nexus-online",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "REPLACE_WITH_HOSTNAME", "custom_domain": true },
    { "pattern": "REPLACE_WITH_MAIL_HOSTNAME", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every request goes through the Worker first, so /app is never served without the Access check.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "REPLACE_WITH_ACCESS_APPLICATION_AUD_TAG",
    "OWNER_EMAIL": "REPLACE_WITH_OWNER_EMAIL",
    // Private inbox host (owner only on every path). Leave unset to turn the inbox off.
    "MAIL_HOST": "REPLACE_WITH_MAIL_HOSTNAME"
  },
  // Same private VPC service the existing nexus-gateway Worker uses.
  "vpc_services": [
    { "binding": "NEXUS_GATEWAY", "service_id": "REPLACE_WITH_VPC_SERVICE_ID", "remote": true },
    // Nexus Mail service on Debian (127.0.0.1:8898), same tunnel. Secret: wrangler secret put MAIL_SERVICE_TOKEN
    { "binding": "NEXUS_MAIL", "service_id": "REPLACE_WITH_MAIL_VPC_SERVICE_ID", "remote": true }
  ],
  // Holds incoming mail only while Debian is unreachable. Create with: npx wrangler d1 create nexus-mail
  "d1_databases": [
    { "binding": "MAIL", "database_name": "nexus-mail", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  // Retries the held mail every 5 minutes.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
